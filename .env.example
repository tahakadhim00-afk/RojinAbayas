# Telegram credentials — server-side only, never exposed to the browser.
# Copy this file to .env.local for local development (.env* is gitignored),
# and set the same variables in the Vercel project settings for production.

# From @BotFather after creating the bot.
TELEGRAM_BOT_TOKEN=

# The chat that receives the orders. To find it: send any message to the bot (or
# add it to the group), then open https://api.telegram.org/bot<TOKEN>/getUpdates
# and read result[0].message.chat.id
# Group and supergroup ids are NEGATIVE (e.g. -1001234567890) — keep the minus
# sign. A group's id changes if Telegram upgrades it to a supergroup.
TELEGRAM_CHAT_ID=

# Optional, for local testing only: point the Bot API at a stub server so test
# submissions don't reach the real chat. Leave unset in production.
# TELEGRAM_API_BASE_URL=http://localhost:4599

# TikTok Pixel ID — public by design (it ships to the browser, hence the
# NEXT_PUBLIC_ prefix). Find it in TikTok Ads Manager > Assets > Events >
# Web Events > your pixel.
#
# Leave unset locally so test submissions don't pollute production conversion
# data: the pixel is a complete no-op when this is empty. In Vercel, scope it
# to Production only so preview deployments stay no-ops. NEXT_PUBLIC_ values
# are inlined at BUILD time, so changing it requires a redeploy.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
