# Telegram credentials — server-side only, never exposed to the browser.
# Copy this file to .env.local for local development (.env* is gitignored),
# and set the same variables in the Vercel project settings for production.

# From @BotFather after creating the bot.
TELEGRAM_BOT_TOKEN=

# The chat that receives the orders. To find it: send any message to the bot (or
# add it to the group), then open https://api.telegram.org/bot<TOKEN>/getUpdates
# and read result[0].message.chat.id
# Group and supergroup ids are NEGATIVE (e.g. -1001234567890) — keep the minus
# sign. A group's id changes if Telegram upgrades it to a supergroup.
TELEGRAM_CHAT_ID=

# Optional, for local testing only: point the Bot API at a stub server so test
# submissions don't reach the real chat. Leave unset in production.
# TELEGRAM_API_BASE_URL=http://localhost:4599

# TikTok Pixel ID — OPTIONAL. The live pixel id is committed as the default in
# src/lib/tiktok.ts (it is public by design: it ships to every visitor's
# browser), so production tracks without setting anything here.
#
# The pixel only runs in production builds, so `npm run dev` never reports test
# submissions into the live data. Set this to:
#   - a pixel id, to deliberately test tracking locally, or
#   - a different id, to point a deployment at another pixel.
# NEXT_PUBLIC_ values are inlined at BUILD time, so changes need a redeploy.
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Optional. The site's public URL, used to build absolute link-preview image
# URLs (og:image) so the logo shows when the link is shared on WhatsApp or
# Telegram. On Vercel this is derived automatically from the production
# domain, so set it only to override — e.g. for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://rojin-abayas.vercel.app
